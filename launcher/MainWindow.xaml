<Window x:Class="ZelrLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="zelr" Height="620" Width="760"
        MinHeight="560" MinWidth="680"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource Bg}" Margin="32,28,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- heading -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="zelr" FontSize="36" FontWeight="Bold"
                       Foreground="{StaticResource Accent}"/>
            <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource Dim}"
                       TextWrapping="Wrap"
                       Text="A small operating system, written from scratch. It has a desktop with draggable windows and a paint program, its own disk, a network connection, and runs real programs. It boots in a safe pretend computer, so nothing touches Windows."/>
        </StackPanel>

        <!-- status -->
        <Border Grid.Row="1" Margin="0,22,0,0" Padding="18,15"
                Background="{StaticResource Panel}" CornerRadius="8"
                BorderBrush="{StaticResource Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10"
                         Margin="0,0,12,0" VerticalAlignment="Center" Fill="{StaticResource Warn}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusTitle" FontSize="14" FontWeight="SemiBold"
                               Text="Checking..."/>
                    <TextBlock x:Name="StatusDetail" FontSize="12.5" Margin="0,3,0,0"
                               Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                               Text=""/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- what to do once it boots -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="20,17"
                Background="{StaticResource Panel}" CornerRadius="8"
                BorderBrush="{StaticResource Border}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Once the black window opens, type these"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="215"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="desktop" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource Accent}" Margin="0,0,0,7"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="windows, a mouse and a paint program" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,0,0,7"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="guide" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource Accent}" Margin="0,0,0,7"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="a short tour of everything else" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,0,0,7"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="exec hello.elf" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource Accent}" Margin="0,0,0,7"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="run a real program in ring 3" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,0,0,7"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="bg count.elf" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource Accent}" Margin="0,0,0,7"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="run one in the background, then: ps" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,0,0,7"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="dhcp" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource Accent}" Margin="0,0,0,7"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="get an address from the network" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,0,0,7"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="fetch example.com / p.html" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource Accent}" Margin="0,0,0,7"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="download a real web page" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,0,0,7"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="help" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource Accent}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="every command" FontSize="13" Foreground="{StaticResource Dim}"/>
                    </Grid>

                    <TextBlock Margin="0,16,0,0" FontSize="12.5" Foreground="{StaticResource Dim}"
                               TextWrapping="Wrap"
                               Text="Your files live on a FAT16 disk image in your AppData folder, so they are still there next time, and other tools can read it. To leave, just close the window."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="StartButton" Style="{StaticResource Primary}"
                    Content="Start zelr" Click="Start_Click" IsEnabled="False"/>
            <Button x:Name="SetupButton" Style="{StaticResource Ghost}"
                    Content="Set up the emulator" Margin="12,0,0,0"
                    Click="Setup_Click" Visibility="Collapsed"/>
            <Button x:Name="RecheckButton" Style="{StaticResource Ghost}"
                    Content="Check again" Margin="12,0,0,0" Click="Recheck_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="0,18,0,0" FontSize="12" Foreground="{StaticResource Dim}">
            <Hyperlink NavigateUri="https://github.com/blavese/zelr"
                       RequestNavigate="Link_Click" Foreground="{StaticResource Dim}">
                Source code on GitHub
            </Hyperlink>
        </TextBlock>
    </Grid>
</Window>
