<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NyxLauncher</RootNamespace>
    <AssemblyName>nyx</AssemblyName>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- How the release is packaged, set here rather than on the command
         line so it cannot be got wrong by whoever runs the publish.

         WPF talks to Windows through native libraries, and a single file
         build leaves them inside the bundle where the loader cannot find
         them unless told to extract them. Without this the window never
         opens: it throws DllNotFoundException out of WindowsBase before
         any of our own code runs, which looks exactly like the kernel
         failing to boot and is nothing of the sort. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- The kernel travels inside the launcher, so the release is one file.
         It is the flat image rather than the ELF: no multiboot loader
         will accept a 64-bit ELF, and QEMU's -kernel is one. -->
    <EmbeddedResource Include="..\build\nyx.bin" Link="nyx.bin" />
  </ItemGroup>

</Project>
